<robot name="example_robot">
	<link name="link0_passive">
		<visual>
			<material name="blue">
				<color rgba="0 0 .8 1"/>
			</material>
			<geometry>
				<origin xyz="0 0 0" rpy="0 0 0"/>
				<cylinder length="0.0" radius="0.0"/>
			</geometry>
		</visual>
	</link>
	<link name="link0_x_axis">
		<visual>
			<material name="red">
				<color rgba="1 0 0 1"/>
			</material>
			<geometry>
				<origin xyz="0 0 0" rpy="0 0 0"/>
				<cylinder length="0.0" radius="0.0"/>
			</geometry>
		</visual>
	</link>
	<joint name="q0_x" type="fixed">
		<origin xyz="0 0 0" rpy="0 1.571 0"/>
		<parent link="link0_passive"/>
		<child link="link0_x_axis"/>
	</joint>
	<link name="link1"/>
	<link name="link1_x_axis">
		<visual>
			<origin xyz="0 0 0.25" rpy="0 0 0"/>
			<material name="red"/>
			<geometry>
				<cylinder length="0.5" radius="0.05"/>
			</geometry>
		</visual>
	</link>
	<joint name="q11" type="revolute">
		<origin xyz="0 0 0" rpy="0 0 0"/>
		<parent link="link0_passive"/>
		<child link="link1"/>
		<axis xyz="0 0 1"/>
        <limit effort="87" lower="-1.8326" upper="0" velocity="3.1416"/>
	</joint>
	<joint name="q11_passive" type="fixed">
		<origin xyz="2 0 0" rpy="0 0 0"/>
		<parent link="link1"/>
		<child link="link1_passive"/>
	</joint>
	<link name="link1_passive">
		<visual>
			<origin xyz="0 0 0.25" rpy="0 0 0"/>
			<material name="blue"/>
			<geometry>
				<cylinder length="0.5" radius="0.05"/>
			</geometry>
		</visual>
	</link>
	<joint name="q11_x" type="fixed">
		<origin xyz="0 0 0" rpy="0 1.571 0"/>
		<parent link="link1_passive"/>
		<child link="link1_x_axis"/>
	</joint>
	<link name="link2"/>
	<link name="link2_x_axis">
		<visual>
			<origin xyz="0 0 0.25" rpy="0 0 0"/>
			<material name="red"/>
			<geometry>
				<cylinder length="0.5" radius="0.05"/>
			</geometry>
		</visual>
	</link>
	<joint name="q12" type="revolute">
		<origin xyz="0 0 0" rpy="0 0 0"/>
		<parent link="link1_passive"/>
		<child link="link2"/>
		<axis xyz="0 0 1"/>
        <limit effort="87" lower="-1.8326" upper="0" velocity="3.1416"/>
	</joint>
	<joint name="q12_passive" type="fixed">
		<origin xyz="1.5 0 0" rpy="0 0 0"/>
		<parent link="link2"/>
		<child link="link2_passive"/>
	</joint>
	<link name="link2_passive">
		<visual>
			<origin xyz="0 0 0.25" rpy="0 0 0"/>
			<material name="blue"/>
			<geometry>
				<cylinder length="0.5" radius="0.05"/>
			</geometry>
		</visual>
	</link>
	<joint name="q12_x" type="fixed">
		<origin xyz="0 0 0" rpy="0 1.571 0"/>
		<parent link="link2_passive"/>
		<child link="link2_x_axis"/>
	</joint>
	<link name="link3"/>
	<link name="link3_x_axis">
		<visual>
			<origin xyz="0 0 0.25" rpy="0 0 0"/>
			<material name="red"/>
			<geometry>
				<cylinder length="0.5" radius="0.05"/>
			</geometry>
		</visual>
	</link>
	<joint name="q13" type="revolute">
		<origin xyz="0 0 0" rpy="0 0 0"/>
		<parent link="link2_passive"/>
		<child link="link3"/>
		<axis xyz="0 0 1"/>
        <limit effort="87" lower="-1.8326" upper="0" velocity="3.1416"/>
	</joint>
	<joint name="q13_passive" type="fixed">
		<origin xyz="0.8 0 0" rpy="0 0 0"/>
		<parent link="link3"/>
		<child link="link3_passive"/>
	</joint>
	<link name="link3_passive">
		<visual>
			<origin xyz="0 0 0.25" rpy="0 0 0"/>
			<material name="blue"/>
			<geometry>
				<cylinder length="0.5" radius="0.05"/>
			</geometry>
		</visual>
	</link>
	<joint name="q13_x" type="fixed">
		<origin xyz="0 0 0" rpy="0 1.571 0"/>
		<parent link="link3_passive"/>
		<child link="link3_x_axis"/>
	</joint>
</robot>