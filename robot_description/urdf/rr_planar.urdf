<?xml version="1.0" ?>
<robot name="robot_planar">

<!--definicionde materiales-->
    <material name="green">
        <color rgba="0 0.5 0 1"/>
    </material>

    <material name="red">
        <color rgba="0 0.5 0 1"/>
    </material>

    <material name="blue">
        <color rgba="0 0.5 0 1"/>
    </material>

    <link name="base_link">
        <visual>
            <geometry>
                <cylinder length="0.3" radius="0.1">
                </cylinder>
            </geometry>
            <origin rpy="0 0 0" xyz="0 0 0.15"/>
            <material name="green"/>
        </visual>
    </link>

    <joint name="q1" type="revolute">
        <parent link="base_link"/>
        <child link="l1"/>
        <limit effort="300" velocity="0.1" lower="-3.1416" upper="3.1416"/>
        <axis xyz="0 0 1"/>
        <origin rpy="0 0 0" xyz="0 0 0.2"/>
    </joint>
    

    <link name="l1">
        <visual>
            <geometry>
                <box size="0.5 0.1 0.2"/>
            </geometry>
            <origin rpy="0 0 0" xyz="0 0 0.15"/>
            <material name="red"/>
        </visual>
    </link>

    <joint name="q2" type="revolute">
        <parent link="l1"/>
        <child link="l2"/>
        <limit effort="300" velocity="0.1" lower="-3.1416" upper="3.1416"/>
        <axis xyz="0 0 1"/>
        <origin rpy="0 0 0" xyz="0.5 0 0.2"/>
    </joint>

    <link name="l2">
        <visual>
            <geometry>
                <box size="0.2 0.1 0.2"/>
            </geometry>
            <origin rpy="0 0 0" xyz="0.1 0 0"/>
            <material name="blue"/>
        </visual>
    </link>

</robot>
